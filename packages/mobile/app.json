{
  "expo": {
    "name": "Vaporlens",
    "slug": "vaporchat",
    "version": "0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "org.vaporlens.Vaporlens",
      "buildNumber": "1",
      "appleTeamId": "EA3F6PEEAV",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "org.vaporlens.Vaporlens",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2D73FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "./plugins/withSceneLifecycle.ts",
      "./plugins/withReleaseSigning.ts",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Vaporlens uses the microphone for Steam voice chat."
        }
      ],
      "./plugins/withoutScreenSharing.ts",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vaporlens sends the photos you pick into Steam chats."
        }
      ],
      "expo-localization",
      "expo-video"
    ],
    "backgroundColor": "#171d25"
  }
}
