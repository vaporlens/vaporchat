{
  "expo": {
    "name": "VaporChat",
    "slug": "vaporchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yamalight.vaporchat",
      "appleTeamId": "EA3F6PEEAV",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.yamalight.vaporchat",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/withSceneLifecycle.ts",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "VaporChat uses the microphone for Steam voice chat."
        }
      ],
      "expo-secure-store"
    ]
  }
}
