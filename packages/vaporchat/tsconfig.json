{
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "client"
  ],
  "compilerOptions": {
    "lib": [
      "ES2024"
    ],
    "types": [
      "node"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
